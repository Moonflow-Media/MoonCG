{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 2048
    },
    "index": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "entries": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 214,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": ["bundle", "module"]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "homepage": {
            "type": "string"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "tags": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "versions": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
                },
                "engine": {
                  "type": "object",
                  "properties": {
                    "mooncg": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "^[0-9A-Za-z.*^~<>=|+\\- ]+$"
                    }
                  },
                  "required": ["mooncg"],
                  "additionalProperties": false
                },
                "dependencies": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "maxLength": 214,
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[0-9A-Za-z.*^~<>=|+\\- ]+$"
                  }
                },
                "source": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "zip"
                        },
                        "url": {
                          "type": "string"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      },
                      "required": ["type", "url", "sha256"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "git"
                        },
                        "url": {
                          "type": "string"
                        },
                        "ref": {
                          "type": "string",
                          "maxLength": 200,
                          "pattern": "^[A-Za-z0-9_][A-Za-z0-9._/-]*$"
                        },
                        "commit": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                        }
                      },
                      "required": ["type", "url", "commit"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": ["version", "source"],
              "additionalProperties": false
            }
          }
        },
        "required": ["name", "kind", "versions"],
        "additionalProperties": false
      }
    }
  },
  "required": ["index", "entries"],
  "additionalProperties": false
}
