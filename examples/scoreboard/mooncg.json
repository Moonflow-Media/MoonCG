{
  "manifest": 1,
  "kind": "bundle",
  "name": "scoreboard",
  "version": "0.1.0",
  "title": "Scoreboard",
  "extension": "extension/index.js",
  "capabilities": ["http.routes"],
  "permissions": { "view": "See the scoreboard", "operate": "Change the score" },
  "defaultRoles": { "operator": ["view", "operate"], "viewer": ["view"], "graphics": ["view"] },
  "panels": [
    {
      "id": "control",
      "title": "Score",
      "file": "dashboard/control.html",
      "width": 3,
      "workspace": "Show",
      "requires": "operate"
    }
  ],
  "dialogs": [
    {
      "id": "confirm-reset",
      "title": "Reset the score?",
      "file": "dashboard/confirm-reset.html",
      "width": 4,
      "requires": "operate"
    }
  ],
  "graphics": [
    {
      "id": "overlay",
      "file": "graphics/overlay.html",
      "width": 1920,
      "height": 1080,
      "singleInstance": true,
      "requires": "view"
    }
  ],
  "replicants": {
    "score": {
      "schema": "schemas/score.json",
      "default": { "home": 0, "away": 0 },
      "persistent": true,
      "read": "view",
      "write": "operate"
    },
    "title": {
      "default": "",
      "read": "view",
      "write": "operate"
    }
  },
  "messages": {
    "reset": { "send": "operate" }
  },
  "assets": [
    {
      "id": "logos",
      "title": "Team logos",
      "accept": ["image/*"],
      "read": "view",
      "write": "operate"
    }
  ],
  "config": { "schema": "schemas/config.json" }
}
